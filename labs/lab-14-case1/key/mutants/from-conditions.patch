diff --git a/test/test_templating_menu.py b/test/test_templating_menu.py
new file mode 100644
index 00000000..860eacc8
--- /dev/null
+++ b/test/test_templating_menu.py
@@ -0,0 +1,52 @@
+"""Characterization and feature tests for the menu() renderers."""
+import unittest
+
+from roundup import hyperdb
+from roundup.anypy.cgi_ import FieldStorage
+from roundup.cgi.templating import HTMLItem
+from roundup.test import memorydb
+from roundup.test.mocknull import MockNull
+
+
+class MenuTest(unittest.TestCase):
+    def setUp(self):
+        self.client = c = MockNull()
+        c.db = db = memorydb.create('admin')
+        db.tx_Source = "web"
+        db.issue.addprop(tx_Source=hyperdb.String())
+        db.security.hasPermission = lambda *a, **k: True
+        c.form = FieldStorage()
+        c._props = MockNull()
+        c.session_api = MockNull(_sid="1")
+        db.getuid = lambda: 10
+        self.k1 = db.keyword.create(name="ui")
+        self.k2 = db.keyword.create(name="db")
+        self.i1 = db.issue.create(title="one", status="5",
+                                  keyword=[self.k1])
+
+    def tearDown(self):
+        self.client.db.close()
+        memorydb.db_nuke('')
+
+    def p(self, name):
+        return HTMLItem(self.client, 'issue', self.i1)[name]
+
+    def test_link_menu_default_has_no_selection(self):
+        html = self.p('status').menu()
+        self.assertIn('<option value="-1">- no selection -</option>', html)
+        self.assertIn('<option selected="selected" value="5">in-progress',
+                      html)
+
+    def test_multilink_menu_default_has_no_selection(self):
+        html = self.p('keyword').menu()
+        self.assertIn('size="3"', html)
+        self.assertIn('- no selection -', html)
+
+    def test_link_menu_show_nosel_false(self):
+        html = self.p('status').menu(show_nosel=False)
+        self.assertNotIn('- no selection -', html)
+
+    def test_multilink_menu_show_nosel_false(self):
+        html = self.p('keyword').menu(show_nosel=False)
+        self.assertNotIn('- no selection -', html)
+        self.assertIn('size="2"', html)
