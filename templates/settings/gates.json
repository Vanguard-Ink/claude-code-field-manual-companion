{
  "permissions": {
    "deny": [
      "Edit(./tests/acceptance/**)",
      "Edit(./.github/**)",
      "Edit(./Makefile)",
      "Edit(./labs/**/grade.sh)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/dod-base)",
      "Edit(./notes/dod-status.txt)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/dod-gate.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-edit.sh"
          }
        ]
      }
    ]
  }
}
